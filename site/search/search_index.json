{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Sonri an Sonjo\u7684\u73b0\u4ee3\u903b\u8f91\u624b\u518c","text":"<p>\u5927\u5bb6\u597d\uff01\u6211\u662fSonri an Sonjo\uff0c\u6b63\u5728\u5b66\u4e60\u73b0\u4ee3\u903b\u8f91\uff0c\u6211\u5c06\u5728\u8fd9\u91cc\u8f7d\u5165\u5e76\u66f4\u65b0\u6211\u7684\u4e2a\u4eba\u5b66\u4e60\u7b14\u8bb0\u3002 ==\u6210\u529f\u5efa\u7ad9\u65f6\u95f4\uff1a2026\u5e749\u67089\u65e522:26(GMT+8:00)==</p>"},{"location":"#_1","title":"\u4e3b\u8981\u76ee\u5f55","text":"<ol> <li>\u6734\u7d20\u96c6\u5408\u8bba\uff08Naive Set Theory\uff09</li> <li>\u547d\u9898\u903b\u8f91\uff08Proposition Logic\uff09</li> <li>\u4e00\u9636\u903b\u8f91\uff08First Order Logic\uff09</li> <li>\u6a21\u6001\u903b\u8f91\uff08Modal Logic\uff09</li> <li>\u4ea4\u66ff\u65f6\u6001\u903b\u8f91\uff08Alternating-time Temporal Logic\uff09</li> </ol>"},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/","title":"\u7d20\u6734\u96c6\u5408\u8bba","text":""},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#i","title":"I. \u516c\u7406\u548c\u7c7b","text":""},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#1","title":"1. \u7c7b\u3001\u96c6\u5408\u4e0e\u516c\u7406","text":""},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#_2","title":"\u7d20\u6734\u96c6\u5408\u8bba","text":"<p>abstract. \u4ecb\u7ecd\u539f\u521d\u6982\u5ff5\uff08\u7c7b\u3001\u96c6\u5408\u3001\u5c5e\u4e8e\uff09\u548cZFC\u516c\u7406 </p>"},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#11","title":"1.1 \u77db\u76fe\u9648\u8ff0","text":"<ul> <li> <p>\u6570\u5b66\u9648\u8ff0\uff08statement\uff09\uff1a\u6709\u771f\u5047\u503c\u7684\u5ba3\u79f0\u3002\u771f\u503c\uff08true\uff09\u548c\u5047\u503c\uff08false\uff09\u76f8\u6392\u65a5\uff08\u4e00\u4e2a\u9648\u8ff0\u662f\u771f\u7684\uff0c\u90a3\u5b83\u5c31\u4e0d\u662f\u5047\u7684\uff0c\u53cd\u4e4b\u4ea6\u7136\uff09\u3002 \u5148\u51b3\u7684\u903b\u8f91\u89c4\u5219\uff1a\u88ab\u7528\u6765\u5e2e\u52a9\u786e\u5b9a\u9648\u8ff0\u771f\u5047\u7684\uff0c\u5df2\u786e\u5b9a\u771f\u5047\u7684\u6570\u5b66\u9648\u8ff0\u53ef\u7ecf\u7ec4\u5408\u903b\u8f91\u5730\u786e\u5b9a\u5176\u4ed6\u4e00\u4e9b\u6570\u5b66\u9648\u8ff0\u7684\u771f\u5047\u3002\u57fa\u672c\u903b\u8f91\u89c4\u5219\u5fc5\u987b\u5f97\u5230\u9075\u5b88\uff0c\u5426\u5219\u8bba\u8bc1\u5c31\u88ab\u8bc4\u4ef7\u4e3a\u201c\u4e0d\u5408\u903b\u8f91\u201d\u3002</p> </li> <li> <p>\u6570\u5b66\u8bba\u8bc1\uff08argument\uff09/\u6f14\u7ece\uff08deduction\uff09\uff1a\u6570\u5b66\u9648\u8ff0\u6309\u7ecf\u903b\u8f91\u89c4\u5219\u786e\u5b9a\u771f\u5047\u7684\u5148\u540e\u987a\u5e8f\u6392\u5217\u7684\u7cfb\u7edf\uff0c\u7531\u4e8e\u903b\u8f91\u89c4\u5219\u7684\u7ec4\u7ec7\u6392\u5217\uff0c\u8fd9\u4e00\u7cfb\u7edf\u662f\u4e25\u8c28\u7684\u3002</p> </li> <li> <p>\u81ea\u660e\uff08self-evident\uff09\u9648\u8ff0\uff1a\u5728\u8bc1\u660e\u7cfb\u7edf\u4e2d\uff0c\u6700\u5f00\u59cb\u7684\u6570\u5b66\u9648\u8ff0\u4e0d\u80fd\u88ab\u5176\u4ed6\u6570\u5b66\u9648\u8ff0\u8bc1\u660e\uff0c\u5b83\u7684\u771f\u5047\u503c\u57fa\u4e8e\u5e38\u8bc6\uff08common sense\uff09\u800c\u5ba3\u79f0\u3002</p> </li> <li> <p>\u8bba\u57df\uff1a\u7ed9\u51fa\u7684\u786e\u5b9a\u7684\u81ea\u8bc1\u9648\u8ff0\u96c6\uff08\\(\\mathscr{A}\\)\uff09\u548c\u4e00\u7cfb\u5217\u903b\u8f91\u89c4\u5219\uff0c\u5c31\u786e\u5b9a\u4e86\u6240\u6709\u53ef\u4ece\u81ea\u660e\u9648\u8ff0\u96c6\u63a8\u5bfc\u51fa\u4e3a\u771f\u7684\u9648\u8ff0\uff0c\u8fd9\u4e9b\u9648\u8ff0\u6784\u6210\u8bba\u57df\uff08\\(\\mathscr{U}_\\mathscr{A}\\)\uff09\uff0c\u4e00\u4e2a\u8bba\u57df\u53ef\u6784\u5efa\u4e00\u95e8\u4f9b\u63a2\u7d22\u53d1\u73b0\u7684\u6570\u5b66\u7406\u8bba\u3002</p> </li> <li> <p>\u77db\u76fe\u9648\u8ff0\uff08contradictory statment\uff09/\u6096\u8bba\uff08paradox\uff09\uff1a\u4e00\u4e2a\u65e2\u88ab\u786e\u5b9a\u4e3a\u771f\u53c8\u88ab\u786e\u5b9a\u4e3a\u5047\u7684\u9648\u8ff0\u3002\u5982\u679c\u4ece\u4e00\u4e2a\u88ab\u89c6\u4f5c\u65e0\u77db\u76fe\u7684\u81ea\u660e\u9648\u8ff0\u4e2d\u903b\u8f91\u5730\u5f97\u51fa\u6096\u8bba\uff0c\u5219\u9700\u8981\u68c0\u67e5\u5bfc\u81f4\u6096\u8bba\u7684\u5047\u8bbe\u3002</p> </li> </ul> <p>\u751f\u8bcd\uff1avice-versa\u53cd\u4e4b\u4ea6\u7136\uff1belaborate\u8be6\u5c3d\u7684\uff1bscrutiny\u4ed4\u7ec6\u68c0\u67e5\uff1brenegade\u53db\u5f92\uff1bingenuity\u806a\u660e\u624d\u667a</p>"},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#12","title":"1.2 \u96c6\u5408","text":"<ul> <li> <p>\u7d20\u6734\u7684\u96c6\u5408\u7406\u89e3\uff1a\uff081\uff09\u96c6\u5408\u5b8c\u5168\u7531\u5b83\u7684\u5143\u7d20\u51b3\u5b9a\uff0c\u4e24\u4e2a\u96c6\u5408\u76f8\u7b49\u5f53\u4e14\u4ec5\u5f53\u5b83\u4eec\u5177\u6709\u76f8\u540c\u7684\u5143\u7d20\u3002[re\uff1a\u5916\u5ef6\u516c\u7406\uff1a\\(\\forall A \\forall B (\\forall x (x \\in A \\leftrightarrow x \\in B) \\rightarrow A = B)\\)]   \uff082\uff09\u96c6\u5408\u7531\u5b83\u5143\u7d20\u6240\u5206\u4eab\u7684\u6027\u8d28\u5b9a\u4e49\uff0c\u8fd9\u4e2a\u6027\u8d28\u662f\u65e0\u6a21\u7cca\u88ab\u826f\u597d\u8868\u8ff0\u7684\uff0c\u4ee5\u81f3\u4e8e\u53ef\u4ee5\u660e\u786e\u5224\u65ad\u4e00\u4e2a\u7ed9\u51fa\u7684\u5143\u7d20\u662f\u5426\u5c5e\u4e8e\u8be5\u96c6\u5408\u3002[\\(\\exists B \\forall x (x \\in B \\leftrightarrow \\varphi(x))\\)]   \u201c\u662f\u4e00\u4e2a\u96c6\u5408\u201d\u4e5f\u662f\u4e00\u79cd\u6027\u8d28\uff0c\u6240\u4ee5\u5b58\u5728\u5173\u4e8e\u96c6\u5408\u7684\u96c6\u5408\u3002</p> </li> <li> <p>\u7f57\u7d20\u6096\u8bba\uff1a\u96c6\u5408\\(R\\)\u662f\u6240\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u6784\u6210\u7684\u96c6\u5408\u3002\u5982\u679c\\(R\\)\u5c5e\u4e8e\u6240\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u6784\u6210\u7684\u96c6\u5408\uff0c\u90a3\u4e48\\(R\\)\u5177\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u8fd9\u4e00\u6027\u8d28\uff0c\\(R\\)\u4e0d\u5c5e\u4e8e\u5b83\u81ea\u8eab\uff0c\u5373\u4e0d\u5c5e\u4e8e\u6240\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u6784\u6210\u7684\u96c6\u5408\uff1b\u5982\u679c\\(R\\)\u4e0d\u5c5e\u4e8e\u6240\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u6784\u6210\u7684\u96c6\u5408\uff0c\u90a3\u4e48\\(R\\)\u4e0d\u5c5e\u4e8e\u5b83\u81ea\u8eab\uff0c\u56e0\u800c\u5177\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u8fd9\u4e00\u6027\u8d28\uff0c\u6240\u4ee5\\(R\\)\u5c5e\u4e8e\u6240\u6709\u201c\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u201d\u6784\u6210\u7684\u96c6\u5408\u3002\u201c\u6240\u6709\u2018\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u2019\u6784\u6210\u7684\u96c6\u5408\u5c5e\u4e8e\u6240\u6709\u2018\u4e0d\u662f\u81ea\u8eab\u5143\u7d20\u7684\u96c6\u5408\u2019\u6784\u6210\u7684\u96c6\u5408\u201d\u662f\u4e00\u4e2a\u6096\u8bba\u3002[re\uff1a\\(R=\\{x\\mid x\\not\\in x\\}\\text{;}R\\in R\\leftrightarrow R\\not\\in R \\Rightarrow \\bot\\)]   \u662f\u54ea\u4e9b\u9519\u8bef\u7684\u5047\u8bbe\u5bfc\u81f4\u4e86\u8fd9\u4e00\u6096\u8bba\uff1f\u8bb8\u591a\u6570\u5b66\u5bb6\u5f00\u59cb\u8ffd\u6eaf\u5230\u201c\u96c6\u5408\u201d\u8fd9\u4e00\u6982\u5ff5\uff0c\u8be5\u95ee\u9898\u572820\u4e16\u7eaa\u521d\u5177\u6709\u9ad8\u4f18\u5148\u6743\uff0c\u5e76\u53d1\u5c55\u51fa\u4e86\u96c6\u5408\u8bba\u7684\u516c\u7406\u7cfb\u7edf\u3002</p> </li> </ul> <p>\u751f\u8bcd\uff1ahockey\u66f2\u68cd\u7403\uff1bentity\u5b9e\u4f53\uff1bextravagant\u6325\u970d\u7684/\u94fa\u5f20\u6d6a\u8d39\u7684\uff1btrivial\u5e73\u51e1\u7684/\u7410\u788e\u7684/\u5fae\u4e0d\u8db3\u9053\u7684\uff1bmalicious virus\u6076\u610f\u75c5\u6bd2\uff1bdormant\u4f11\u7720\u7684/\u6f5c\u4f0f\u7684\uff1bundermine\u7834\u574f/\u524a\u5f31\u4fe1\u5fc3\uff1birrefutable\u65e0\u53ef\u8fa9\u9a73\u7684\uff1bcrack\u7455\u75b5/\u7f3a\u70b9\uff1berroneous\u9519\u8bef\u7684</p>"},{"location":"%E7%B4%A0%E6%9C%B4%E9%9B%86%E5%90%88%E8%AE%BA/#13","title":"1.3 \u516c\u7406\u7cfb\u7edf","text":"<p>\u516c\u7406\u7cfb\u7edf\u7684\u5efa\u7acb\uff1a\uff081\uff09\u58f0\u660e\u539f\u521d\u6216\u672a\u5b9a\u4e49\u6982\u5ff5\uff0c\u5b83\u4eec\u6ca1\u6709\u56fa\u6709\u610f\u4e49\uff0c\u867d\u7136\u8868\u8ff0\u6587\u5b57\u4f1a\u5f15\u8d77\u9605\u8bfb\u8005\u5fc3\u7075\u4e2d\u7684\u76f4\u89c9\u89c2\u5ff5\uff1b\uff082\uff09\u5ba3\u5e03\u6982\u5ff5\u4e4b\u95f4\u5173\u7cfb\u7684\u7279\u522b\u7684\u89c4\u5219\u548c\u6027\u8d28\uff0c\u88ab\u79f0\u4e3a\u201c\u516c\u7406\u201d\u3002</p> <ul> <li>\u6b27\u51e0\u91cc\u5f97\u516c\u7406\u7cfb\u7edf\uff1a\u6b27\u51e0\u91cc\u5f97\u662f\u7b2c\u4e00\u4e2a\u7528\u516c\u7406\u5316\u65b9\u6cd5\u7814\u7a76\u51e0\u4f55\u5b66\u7684\u4eba\u3002\u5728\u4ed6\u7684\u516c\u7406\u7cfb\u7edf\u4e2d\uff1a\uff081\uff09\u6b27\u51e0\u91cc\u5f97\u5c06\u201c\u70b9\u201d\u548c\u201c\u7ebf\u201d\u5ba3\u5e03\u4e3a\u539f\u521d\u6982\u5ff5\uff1b\uff082\uff09\u6b27\u51e0\u91cc\u5f97\u5c06\u5173\u4e8e\u70b9\u548c\u7ebf\u6027\u8d28\u7684\u63cf\u8ff0\u4f5c\u4e3a\u516c\u7406\uff0c\u8fd9\u4e9b\u516c\u7406\u7684\u9648\u8ff0\u662f\u88ab\u5ba3\u5e03\u4e3a\u81ea\u660e\u800c\u5047\u5b9a\u4e3a\u771f\u7684\uff08\u800c\u975e\u903b\u8f91\u6f14\u7ece\u5f97\u5230\uff09\uff0c\u5b83\u6784\u6210\u4e86\u88ab\u79f0\u4e3a\u201c\u6b27\u51e0\u91cc\u5f97\u51e0\u4f55\u201d\u7684\u8bba\u57df\uff1b\uff083\uff09\u6b27\u51e0\u91cc\u5f97\u7528\u6f14\u7ece\u63a8\u7406\u5f97\u5230\u591a\u79cd\u771f\u7684\u51e0\u4f55\u5b66\u9648\u8ff0\uff0c\u58f0\u79f0\u524d\u63d0\u5b8c\u5168\u6765\u81ea\u4e8ea.\u516c\u7406\u548cb.\u5df2\u5728\u524d\u9762\u8bc1\u660e\u4e3a\u771f\u7684\u9648\u8ff0\u3002   \u4e0d\u8fc7\uff0c\u6b27\u51e0\u91cc\u5f97\u8fd8\u662f\u4e0d\u77e5\u4e0d\u89c9\u4f7f\u7528\u4e86\u5728\u516c\u7406\u548c\u4ee5\u8bc1\u5f97\u9648\u8ff0\u4e4b\u5916\u7684\u524d\u63d0\uff0c1899\u5e74\u5927\u536b\u00b7\u5e0c\u5c14\u4f2f\u7279\u4fee\u8ba2\u4e86\u6b27\u51e0\u91cc\u5f97\u516c\u7406\u7cfb\u7edf\u4e3a3\u4e2a\u539f\u521d\u6982\u5ff5\u548c21\u6761\u516c\u7406\uff0c1902\u5e74\u4e00\u6761\u516c\u7406\u88ab\u8ba4\u4e3a\u662f\u591a\u4f59\u7684\u800c\u5220\u9664\u81f320\u6761\u3002</li> </ul> <p>\u751f\u8bcd\uff1aintrinsic\u56fa\u6709\u7684/\u5185\u5728\u7684\uff1bscrutiny\u4ed4\u7ec6\u68c0\u67e5\uff1berr\u72af\u9519\u8bef\uff1bredundant\u591a\u4f59\u7684</p>"}]}